<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Single project for the whole modular monolith, mirroring the
      CourseCore layout (section 5): Modules/{Módulo}/{Application,Domain,
      Infrastructure,Presentation} live side by side here instead of in
      separate per-layer assemblies. Layer boundaries (Domain must not
      depend on Infrastructure/ASP.NET Core/EF Core, a module must not
      reach into another module's internals) are enforced by
      OrderCore.ArchitectureTests via NetArchTest namespace rules, not by
      project references.
    -->
    <RootNamespace>OrderCore.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests\ and Docs\ sit next to this project at the repo root, same
         as CourseCore's Tests\/Docs\ — neither is part of the API project
         itself, so both are excluded from its default SDK-style globs. -->
    <Compile Remove="Tests\**\*.cs" />
    <Content Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
    <Content Remove="Docs\**\*" />
    <None Remove="Docs\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <!-- Pinned explicitly: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 pulls
         EFCore.Relational 10.0.4 transitively, which would otherwise win
         over the 10.0.9 this project and its test projects build against. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- OpenAPI/Scalar (section "API Conventions" in claude.md): the .NET
         9+ built-in generator produces the OpenAPI ("swagger") document,
         Scalar.AspNetCore renders it as an interactive UI. No Swashbuckle —
         SwaggerUI itself was dropped from the ASP.NET Core templates in
         favor of this pairing, and Microsoft.AspNetCore.OpenApi already
         reads the [ProducesResponseType] attributes every controller in
         this project already carries. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.9" />
    <!-- Identity module: validates the access tokens OrderCore issues, and
         its JsonWebTokenHandler is also what issues them (no ASP.NET Core
         Identity, no external identity provider). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
  </ItemGroup>

</Project>
