<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Single project for the whole modular monolith, mirroring the
      CourseCore layout (section 5): Modules/{Módulo}/{Application,Domain,
      Infrastructure,Presentation} live side by side here instead of in
      separate per-layer assemblies. Layer boundaries (Domain must not
      depend on Infrastructure/ASP.NET Core/EF Core, a module must not
      reach into another module's internals) are enforced by
      OrderCore.ArchitectureTests via NetArchTest namespace rules, not by
      project references.
    -->
    <RootNamespace>OrderCore.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests\ sits next to this project at the repo root, same as CourseCore's Tests\ -->
    <Compile Remove="Tests\**\*.cs" />
    <Content Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
  </ItemGroup>

</Project>
