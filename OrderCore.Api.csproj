<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Single project for the whole modular monolith, mirroring the
      CourseCore layout (section 5): Modules/{Módulo}/{Application,Domain,
      Infrastructure,Presentation} live side by side here instead of in
      separate per-layer assemblies. Layer boundaries (Domain must not
      depend on Infrastructure/ASP.NET Core/EF Core, a module must not
      reach into another module's internals) are enforced by
      OrderCore.ArchitectureTests via NetArchTest namespace rules, not by
      project references.
    -->
    <RootNamespace>OrderCore.Api</RootNamespace>
    <!-- Local secrets (Jwt:SigningKey, IdentitySeed:*) for `dotnet run`:
         `dotnet user-secrets set "Jwt:SigningKey" "..."`. Never in appsettings. -->
    <UserSecretsId>ordercore-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests\ and Docs\ sit next to this project at the repo root, same
         as CourseCore's Tests\/Docs\ — neither is part of the API project
         itself, so both are excluded from its default SDK-style globs. -->
    <Compile Remove="Tests\**\*.cs" />
    <Content Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
    <Content Remove="Docs\**\*" />
    <None Remove="Docs\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <!-- Pinned explicitly: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 pulls
         EFCore.Relational 10.0.4 transitively, which would otherwise win
         over the 10.0.9 this project and its test projects build against. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- OpenAPI/Scalar (section "API Conventions" in claude.md): the .NET
         9+ built-in generator produces the OpenAPI ("swagger") document,
         Scalar.AspNetCore renders it as an interactive UI. No Swashbuckle —
         SwaggerUI itself was dropped from the ASP.NET Core templates in
         favor of this pairing, and Microsoft.AspNetCore.OpenApi already
         reads the [ProducesResponseType] attributes every controller in
         this project already carries. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.9" />
    <!-- Identity module: validates the access tokens OrderCore issues, and
         its JsonWebTokenHandler is also what issues them (no ASP.NET Core
         Identity, no external identity provider). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <!-- Messaging module: the official RabbitMQ client, used directly (no
         messaging framework — Docs/specs/events/async-messaging.md,
         decision 1): outbox relay, retries, dead-lettering and the inbox are
         written in the project. -->
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <!-- Observability (Docs/specs/observability/observability.md): OpenTelemetry
         traces, metrics and logs, exported over OTLP (Grafana LGTM in
         docker compose). Nothing is exported when no endpoint is configured. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <!-- Payments: Stripe's official SDK (Docs/specs/payments/stripe-provider.md).
         Used only when Payments:Stripe:SecretKey is configured. -->
    <PackageReference Include="Stripe.net" Version="52.4.2" />
  </ItemGroup>

</Project>
