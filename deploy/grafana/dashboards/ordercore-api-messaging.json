    {
      "id": 14,
      "type": "bargauge",
      "title": "Mensagens postas de lado no período",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
