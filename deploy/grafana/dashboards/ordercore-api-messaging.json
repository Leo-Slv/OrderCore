        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (messaging_destination_name, ordercore_messaging_attempt) (increase(ordercore_messaging_retries_total{job=\"ordercore-api\"}[$__rate_interval]))",
          "legendFormat": "{{messaging_destination_name}} tentativa {{ordercore_messaging_attempt}}"
