    {
      "id": 16,
      "type": "table",
      "title": "Traces recentes com erro",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"ordercore-api\" && status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      }
    }
