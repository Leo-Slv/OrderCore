            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (ordercore_module) (rate(ordercore_messaging_published_total{job=\"ordercore-api\"}[$__rate_interval]))",
          "legendFormat": "publicadas {{ordercore_module}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (ordercore_module) (rate(ordercore_messaging_publish_failures_total{job=\"ordercore-api\"}[$__rate_interval]))",
          "legendFormat": "falhas {{ordercore_module}}"
