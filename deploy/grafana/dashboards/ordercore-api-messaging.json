      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (ordercore_module) (ordercore_messaging_outbox_oldest_age_seconds{job=\"ordercore-api\"})",
