# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.

# At least 32 bytes. Generate one, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=

# First administrator, created on startup if no admin exists yet.
# Password: 8-128 characters, at least one letter and one digit.
ADMIN_EMAIL=admin@ordercore.local
ADMIN_PASSWORD=
