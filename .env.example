# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.

# At least 32 bytes. Generate one, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=

# First administrator, created on startup if no admin exists yet.
# Password: 8-128 characters, at least one letter and one digit.
ADMIN_EMAIL=admin@ordercore.local
ADMIN_PASSWORD=

# RabbitMQ (async messaging between modules). The API uses the same
# user; for dotnet run outside compose, set RabbitMq:Password in
# user-secrets (RabbitMq:Username defaults to "ordercore").
RABBITMQ_USER=ordercore
RABBITMQ_PASSWORD=

# Stripe in test mode (optional). Empty STRIPE_SECRET_KEY = the fake
# provider (Card and Pix, answers at once). With the keys from
# dashboard.stripe.com/test/apikeys the API uses Stripe (Card only), and
# `docker compose --profile stripe up` also starts the Stripe CLI, which
# forwards Stripe's webhooks to the API. Its signing secret is stable per
# account; print it once and paste it below:
#   docker compose --profile stripe run --rm --no-deps stripe-cli listen --print-secret
# Test keys only (sk_test_/pk_test_) — never live keys, never committed.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe test cards (any future expiry, any CVC, any postal code):
#   4242 4242 4242 4242  approved
#   4000 0000 0000 0002  declined (card_declined)
#   4000 0000 0000 9995  declined (insufficient_funds)
#   4000 0025 0000 3155  asks for 3-D Secure, then approved
